# GEMINI_API_KEY: Required for Gemini AI API calls (Intake, Planner, Ops, Vendor, Ideas agents).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Aayojan Engine & Resilience Configuration
MODEL_PRIMARY="gemini-3.8-flash"
MODEL_FAST="gemini-3.8-flash"
LLM_DAILY_USER_QUOTA="100"
LLM_GLOBAL_SPEND_CAP="50.00"
TEMPLATE_ONLY_MODE="false"
SHARE_TOKEN_PEPPER="aayojan-default-pepper-v1"
