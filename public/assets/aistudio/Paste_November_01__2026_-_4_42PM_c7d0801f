create table event_versions (
  event_id uuid references events(id) on delete cascade,
  version int not null,
  state jsonb not null,
  ops jsonb not null,
  diff jsonb not null,
  cause text not null,
  health int not null,
  created_by uuid,
  created_at timestamptz default now(),
  primary key (event_id, version)
);
create table jobs (
  id uuid primary key default gen_random_uuid(),
  event_id uuid, kind text,
  status text check (status in ('queued','running','done','failed')),
  stage text, result jsonb, error jsonb,
  idempotency_key text unique,
  created_at timestamptz default now(), finished_at timestamptz
);
create table expenses (id uuid primary key default gen_random_uuid(), event_id uuid references events(id) on delete cascade, category text not null, amount int not null check (amount >= 0), note text, paid_on date, created_at timestamptz default now());
create table quotes (id uuid primary key default gen_random_uuid(), event_id uuid references events(id) on delete cascade, category text not null, vendor_name text not null, amount int not null, inclusions text, received_on date);
create table share_links (token_hash text primary key, event_id uuid references events(id) on delete cascade, role text check (role in ('family','vendor','volunteer')), scope jsonb, expires_at timestamptz not null, revoked_at timestamptz);
create table audit_log (id bigserial primary key, event_id uuid, actor uuid, action text, meta jsonb, at timestamptz default now());
create table templates (id serial primary key, event_type text, region text, kind text, title text, body text, source text, embedding vector(1024));
Concurrency: writes use update events set ... where id = $1 and current_version = $2 (optimistic lock); zero rows updated returns 409 with the latest version. Row-level security on every table: owner has full access; share-link access only through server-side role-scoped views. Indexes: event_versions(event_id, version desc), jobs(idempotency_key), HNSW on templates.embedding.
5. Domain engine (deterministic core)
5.1 Event schema
Fields: version, type, event_date, today, guests, city, city_tier (1..3), budget (int rupees), tier (lean|standard|premium), brief (vibe, constraints, assumptions[]), functions[] (wedding only: name, date, guests), lines[] (category, planned, actual, locked, floor), tasks[] (id, title, category, start, due, duration_days, depends_on[], owner, status, critical), vendors[] (category, name, status, quote, capacity), ideas, risks[]. Implement with Pydantic v2, extra='forbid', strict types, bounded string lengths. Mirror the pure functions in a small TypeScript package for instant slider preview.
5.2 Typed operations (closed vocabulary)
SetBudget(total), SetGuests(n, function?), SetDate(date), SetCity(city), SetTier(tier), LockLine(category), UnlockLine(category), SetLine(category, amount), CancelVendor(category, name?), SelectVendor(category, name), AddTask(...), RemoveTask(id), MoveTask(id, due), AssignTask(id, owner), SetStatus(id, status), AddFunction(...), RemoveFunction(name), SetIdeas(section, content). Anything else is rejected with unsupported_operation and a suggestion.
5.3 Algorithms
• Budget baseline: percentage template by event type and tier (Appendix A), adjusted by city-tier multiplier and guest count. Code rounds to integer rupees and fixes drift on the largest unlocked line. The LLM may suggest shifts of at most 5 percentage points per category; code clamps them.
• Rescale: locked lines fixed; free lines scale proportionally; per-line floors respected; if floors make the target infeasible, return infeasible_budget with the minimum feasible total.
• Timeline: backward scheduling from the event date. Each task has a typical lead time from the template; due = event_date - lead; dependents are pushed earlier by a topological pass so I5 holds; critical path = longest dependency chain. If today is later than the earliest required start, flag compressed_timeline and mark affected tasks at risk.
• Date cascade: SetDate recomputes all non-completed task dates, keeps completed ones, and re-runs the risk pass.
• Health score (0-100), fully itemized: start at 100 and subtract: budget per guest vs tier band (max 30), lead-time risk from compressed or overdue tasks (max 30), contingency shortfall (max 10), critical-path slack under 2 days (max 15), unassigned owners (max 5), overruns in actuals (max 10). Return [{code, points, why, fix}]; the UI renders each reason with a one-tap fix.
• Diff: by stable ids; reports budget line changes, tasks added, removed and moved, vendor changes and health delta. The one-sentence summary is generated from diff data by a template, not the LLM, so it is always correct.
